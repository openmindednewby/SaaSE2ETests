# Copy file: dependencies (dist only, per their `files` field) instead of symlinking their whole
# directory. Without this, the symlinked @dloizides/e2e-helpers exposes its OWN nested
# node_modules/@playwright/test (a different resolved version than ours), giving TypeScript two
# distinct APIRequestContext identities and a spurious type-identity clash. install-links makes the
# package's peer @playwright/test resolve from THIS project — a single Playwright identity.
install-links=true
